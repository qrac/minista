{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/core/**/*.js",
    "src/core/**/*.d.ts",
    "src/features/**/*.js",
    "src/features/**/*.d.ts",
    "src/adapters/**/*.js",
    "src/adapters/**/*.d.ts"
  ]
}
