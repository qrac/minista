{
  "name": "minista",
  "version": "5.0.0",
  "type": "module",
  "bin": {
    "minista": "./bin/minista.js"
  },
  "main": "./src/node.js",
  "types": "./src/node.d.ts",
  "exports": {
    ".": {
      "import": "./src/node.js",
      "types": "./src/node.d.ts"
    },
    "./types": {
      "types": "./src/types.d.ts"
    },
    "./client": {
      "types": "./src/client.d.ts"
    },
    "./context": {
      "import": "./src/context.js",
      "types": "./src/context.d.ts"
    },
    "./head": {
      "import": "./src/head.js",
      "types": "./src/head.d.ts"
    },
    "./assets": {
      "import": "./src/assets.js",
      "types": "./src/assets.d.ts"
    },
    "./internal/query": {
      "import": "./src/internal/query.js",
      "types": "./src/internal/query.d.ts"
    },
    "./package.json": {
      "import": "./package.json"
    }
  },
  "files": [
    "bin",
    "src",
    "types"
  ],
  "scripts": {
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit"
  },
  "license": "MIT",
  "homepage": "https://minista.qranoko.jp",
  "repository": {
    "type": "git",
    "url": "https://github.com/qrac/minista",
    "directory": "packages/minista"
  },
  "bugs": {
    "url": "https://github.com/qrac/minista/issues"
  },
  "keywords": [
    "static-site-generator",
    "ssg",
    "react",
    "vite-plugin",
    "minista"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "archiver": "^8.0.0",
    "cross-spawn": "^7.0.6",
    "estree-util-value-to-estree": "^3.5.0",
    "js-beautify": "^2.0.3",
    "magic-string": "^1.2.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mime-types": "^3.0.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "mojigiri": "^0.3.0",
    "node-html-parser": "^9.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "sharp": "^0.35.4",
    "source-map": "^0.8.0",
    "svgo": "^4.1.0",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0"
  }
}
